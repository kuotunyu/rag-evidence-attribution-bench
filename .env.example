# Copy to .env if needed. Never commit .env.

# Hugging Face token — only needed if HF gates the datasets/models used (all public today).
HF_TOKEN=

# Optional: relocate the HF cache (Colab: /content/hf_cache).
HF_HOME=

# Serve overrides (Docker sets HOST to 0.0.0.0; Colab sets RESULTS dirs to the Drive mount).
RAG_EVIDENCE_HOST=
RAG_EVIDENCE_PORT=
RAG_EVIDENCE_RESULTS_RAW=
RAG_EVIDENCE_RESULTS_DERIVED=
