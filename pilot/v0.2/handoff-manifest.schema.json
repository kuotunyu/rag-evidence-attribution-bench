{
  "$defs": {
    "ExpectedLayoutV2": {
      "additionalProperties": false,
      "properties": {
        "external_root_files": {
          "default": [
            "handoff-receipt.json",
            "SHA256SUMS"
          ],
          "items": {
            "type": "string"
          },
          "title": "External Root Files",
          "type": "array"
        },
        "kit_a_directory": {
          "const": "kit-a",
          "default": "kit-a",
          "title": "Kit A Directory",
          "type": "string"
        },
        "kit_b_directory": {
          "const": "kit-b",
          "default": "kit-b",
          "title": "Kit B Directory",
          "type": "string"
        },
        "kit_a_files": {
          "default": [
            "<verified-wheel>",
            "annotation-requirements-py311.lock",
            "ONBOARDING.md",
            "HANDOFF_RUNBOOK.md",
            "start.ps1",
            "start.sh",
            "SHA256SUMS",
            "ann-pilot-a.json"
          ],
          "items": {
            "type": "string"
          },
          "title": "Kit A Files",
          "type": "array"
        },
        "kit_b_files": {
          "default": [
            "<verified-wheel>",
            "annotation-requirements-py311.lock",
            "ONBOARDING.md",
            "HANDOFF_RUNBOOK.md",
            "start.ps1",
            "start.sh",
            "SHA256SUMS",
            "ann-pilot-b.json"
          ],
          "items": {
            "type": "string"
          },
          "title": "Kit B Files",
          "type": "array"
        }
      },
      "title": "ExpectedLayoutV2",
      "type": "object"
    },
    "ReproducibleBuildRecipeV2": {
      "additionalProperties": false,
      "properties": {
        "source_date_epoch": {
          "const": 1787443200,
          "default": 1787443200,
          "title": "Source Date Epoch",
          "type": "integer"
        },
        "build_command": {
          "default": [
            "uv",
            "build",
            "--wheel",
            "--out-dir",
            "<external-dist>"
          ],
          "items": {
            "type": "string"
          },
          "title": "Build Command",
          "type": "array"
        },
        "wheel_policy": {
          "const": "byte-identical-required",
          "default": "byte-identical-required",
          "title": "Wheel Policy",
          "type": "string"
        },
        "required_instances": {
          "const": 4,
          "default": 4,
          "title": "Required Instances",
          "type": "integer"
        },
        "environment_policy": {
          "default": [
            "external-cache",
            "external-build-root",
            "external-output",
            "external-pycache",
            "PYTHONDONTWRITEBYTECODE=1"
          ],
          "items": {
            "type": "string"
          },
          "title": "Environment Policy",
          "type": "array"
        }
      },
      "title": "ReproducibleBuildRecipeV2",
      "type": "object"
    },
    "SupportedEnvironmentV2": {
      "additionalProperties": false,
      "properties": {
        "python": {
          "const": "3.11",
          "default": "3.11",
          "title": "Python",
          "type": "string"
        },
        "required_verification_platforms": {
          "default": [
            "Windows",
            "Linux"
          ],
          "items": {
            "enum": [
              "Windows",
              "Linux"
            ],
            "type": "string"
          },
          "title": "Required Verification Platforms",
          "type": "array"
        },
        "dependency_lock": {
          "const": "annotation-requirements-py311.lock",
          "default": "annotation-requirements-py311.lock",
          "title": "Dependency Lock",
          "type": "string"
        },
        "dependency_bootstrap_argv": {
          "default": [
            "python",
            "-m",
            "pip",
            "install",
            "--require-hashes",
            "--only-binary=:all:",
            "-r",
            "annotation-requirements-py311.lock"
          ],
          "items": {
            "type": "string"
          },
          "title": "Dependency Bootstrap Argv",
          "type": "array"
        },
        "wheel_install_argv": {
          "default": [
            "python",
            "-m",
            "pip",
            "install",
            "--no-deps",
            "<verified-wheel>"
          ],
          "items": {
            "type": "string"
          },
          "title": "Wheel Install Argv",
          "type": "array"
        }
      },
      "title": "SupportedEnvironmentV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "handoff-manifest-v2",
      "default": "handoff-manifest-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_version": {
      "const": "handoff-spec-v2",
      "default": "handoff-spec-v2",
      "title": "Spec Version",
      "type": "string"
    },
    "builder_version": {
      "const": "handoff-builder-v2",
      "default": "handoff-builder-v2",
      "title": "Builder Version",
      "type": "string"
    },
    "protocol_version": {
      "const": "pilot-v0.2.2-draft",
      "default": "pilot-v0.2.2-draft",
      "title": "Protocol Version",
      "type": "string"
    },
    "python_distribution": {
      "const": "0.2.0.dev0",
      "default": "0.2.0.dev0",
      "title": "Python Distribution",
      "type": "string"
    },
    "required_verification_platforms": {
      "default": [
        "Windows",
        "Linux"
      ],
      "items": {
        "enum": [
          "Windows",
          "Linux"
        ],
        "type": "string"
      },
      "title": "Required Verification Platforms",
      "type": "array"
    },
    "supported_environment": {
      "$ref": "#/$defs/SupportedEnvironmentV2"
    },
    "source_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Paths",
      "type": "object"
    },
    "canonical_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Canonical Sha256",
      "type": "object"
    },
    "canonical_package_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Canonical Package Sha256",
      "type": "object"
    },
    "instruction_version": {
      "const": "pilot-v0.2.2-draft",
      "default": "pilot-v0.2.2-draft",
      "title": "Instruction Version",
      "type": "string"
    },
    "instruction_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Instruction Sha256",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Lock Sha256",
      "type": "string"
    },
    "expected_layout": {
      "$ref": "#/$defs/ExpectedLayoutV2"
    },
    "reproducible_build": {
      "$ref": "#/$defs/ReproducibleBuildRecipeV2"
    }
  },
  "required": [
    "supported_environment",
    "source_paths",
    "canonical_sha256",
    "canonical_package_sha256",
    "instruction_sha256",
    "dependency_lock_sha256",
    "expected_layout",
    "reproducible_build"
  ],
  "title": "HandoffSpecV2",
  "type": "object"
}
