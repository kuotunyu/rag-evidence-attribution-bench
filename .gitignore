# environments / caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# secrets & env
.env
*.token

# data & model weights — never committed
models/
*.safetensors
*.bin
*.gguf
*.ckpt
.cache/
