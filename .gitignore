# heavy raw artifacts — committed raw results are JSONL/JSON only
results/raw/**/embeddings/
results/raw/cache/
results/**/*.pt
results/**/*.npy
results/**/*.npz
results/export/

# notebooks
.ipynb_checkpoints/

# Colab transport bundle (regenerated by scripts/make_colab_bundle.py)
reab_bundle.zip

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
