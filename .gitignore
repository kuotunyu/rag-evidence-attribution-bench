# environments / caches
.venv/
.worktrees/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 私人面試筆記與本機開發輔助文檔
PROGRESS.md
interview*.md
INTERVIEW_PREP.md
*.private.md
.agents/
.claude/
CLAUDE.md
