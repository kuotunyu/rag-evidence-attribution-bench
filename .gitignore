# secrets & env
.env
*.token

# data & model weights — never committed
models/
*.safetensors
*.bin
*.gguf
*.ckpt
.cache/
huggingface/

# keep the committed split manifest despite data/ being ignored
!data/
data/*
!data/manifests/
data/manifests/*
!data/manifests/split_manifest.json

# heavy raw artifacts — committed raw results are JSONL/JSON only
results/raw/**/embeddings/
results/raw/cache/
results/reranking/raw/cache/
results/**/*.pt
results/**/*.npy
results/**/*.npz
results/export/

# notebooks
.ipynb_checkpoints/

# Colab transport bundle (regenerated by scripts/make_colab_bundle.py)
reab_bundle.zip

# Colab result exports dropped anywhere in the tree — import them with
# `cli import-results`, never commit the zips themselves
results_*.zip

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
